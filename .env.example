# ┌─────────────────────────────────────────────────────────────┐
# │ 이 파일을 .env 로 복사한 뒤, 아래 값을 실제 값으로 채우세요.    │
# │   cp .env.example .env                                        │
# │ .env 는 .gitignore 처리되어 git에 절대 올라가지 않습니다.       │
# │ (메일/리포트 파이프라인 shell/ 을 쓸 때만 필요 — 미사용 시 생략) │
# └─────────────────────────────────────────────────────────────┘

# ── SMTP 서버 (테스트 결과 메일 발송: shell/curl.sh) ──
# Gmail 사용 시: SMTP_HOST=smtp.gmail.com / SMTP_PORT=587
# ※ SMTP_PASS 는 일반 로그인 비밀번호가 아니라 "앱 비밀번호"를 넣으세요.
#   (Gmail: 계정 → 보안 → 2단계 인증 → 앱 비밀번호 에서 발급)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password

# ── 메일 발신/수신 주소 ──
MAIL_FROM=your_email@example.com
MAIL_TO=recipient@example.com
# 수신자가 여러 명이면 콤마로 구분: MAIL_TO=a@example.com, b@example.com

# ── 테스트 실행 옵션 ──
ENVIRONMENT=Docker                 # 리포트/메일 제목에 표시할 환경 이름 (자유 문자열)
SPEC_FILE=cypress/e2e/**/*.cy.js   # 실행할 스펙 경로(글롭). 특정 스펙만: cypress/e2e/sample/sample.dom.cy.js
REPEAT_COUNT=3                     # docker:repeat / run-repeat.sh 반복 실행 횟수
