# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 .gitignore 처리됨)
# 메일/리포트 파이프라인(shell/)을 사용할 때만 필요합니다 — 미사용 시 생략 가능.

# --- SMTP (메일 발송: shell/curl.sh) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password

# --- 메일 발신/수신 주소 ---
MAIL_FROM=your_email@example.com
MAIL_TO=recipient@example.com
# 다중 수신자는 콤마로 구분: MAIL_TO=a@example.com, b@example.com

# --- Cypress 실행 ---
CYPRESS_RECORD_KEY=your_cypress_record_key   # (선택) Cypress Cloud 기록 키
ENVIRONMENT=Docker                            # 리포트 표기용 환경 이름
SPEC_FILE=cypress/e2e/**/*.cy.js              # 실행할 스펙 경로
REPEAT_COUNT=3                                # run-repeat 반복 횟수
