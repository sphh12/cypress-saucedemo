# ┌─────────────────────────────────────────────────────────────┐
# │ 이 파일을 .env 로 복사한 뒤, 아래 값을 실제 값으로 채우세요.    │
# │   cp .env.example .env                                        │
# │ .env 는 .gitignore 처리되어 git에 절대 올라가지 않습니다.       │
# │ (메일/리포트 파이프라인 shell/ 을 쓸 때만 필요 — 미사용 시 생략) │
# └─────────────────────────────────────────────────────────────┘

# ── SMTP 서버 (테스트 결과 메일 발송: shell/curl.sh) ──
# [용도]   curl.sh 가 결과 메일을 보낼 때 접속할 메일 서버.
# [발급]   별도 발급 없음. 사용하는 메일 서비스의 SMTP 주소/포트를 입력.
#          · Gmail   : smtp.gmail.com / 587
#          · Naver   : smtp.naver.com / 587
#          · Outlook : smtp.office365.com / 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# [용도]   SMTP 인증 계정 (보통 보내는 메일 주소와 동일).
SMTP_USER=your_email@example.com

# [용도]   SMTP 로그인 비밀번호. ※ 일반 로그인 비번이 아니라 "앱 비밀번호"를 넣으세요.
# [발급]   Gmail 기준: ① 2단계 인증(2FA) 먼저 켜기 → ② 앱 비밀번호 발급
#          · 2단계 인증 :  https://myaccount.google.com/security
#          · 앱 비밀번호 :  https://myaccount.google.com/apppasswords
#          (Naver: 메일 → 환경설정 → POP3/IMAP → "애플리케이션 비밀번호")
SMTP_PASS=your_app_password

# ── 메일 발신/수신 주소 ──
# [용도]   결과 메일의 보내는 사람(From) / 받는 사람(To). 발급 불필요, 주소만 입력.
MAIL_FROM=your_email@example.com
MAIL_TO=recipient@example.com
# 수신자가 여러 명이면 콤마로 구분: MAIL_TO=a@example.com, b@example.com

# ── 테스트 실행 옵션 (발급 불필요, 값만 조정) ──
# [용도]   리포트/메일 제목에 표시할 환경 이름 (자유 문자열).
ENVIRONMENT=Docker
# [용도]   실행할 스펙 경로(글롭). 특정 스펙만: cypress/e2e/sample/sample.dom.cy.js
SPEC_FILE=cypress/e2e/**/*.cy.js
# [용도]   docker:repeat / run-repeat.sh 반복 실행 횟수.
REPEAT_COUNT=3
