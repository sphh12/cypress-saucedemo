{
  "name": "cypress-saucedemo",
  "version": "1.0.0",
  "description": "Swag Labs(saucedemo.com) E2E 테스트 자동화 — Cypress + POM (7 스펙 / 27 테스트)",
  "type": "commonjs",
  "scripts": {
    "open": "cypress open",
    "test": "cypress run --browser chrome --spec \"cypress/e2e/saucedemo/**/*.cy.js\"",
    "test:chrome": "cypress run --browser chrome --spec \"cypress/e2e/saucedemo/**/*.cy.js\"",
    "test:electron": "cypress run --browser electron --spec \"cypress/e2e/saucedemo/**/*.cy.js\"",
    "repeat": "cypress-repeat run -n 3 --browser chrome --spec \"cypress/e2e/saucedemo/**/*.cy.js\"",
    "test:history": "node shell/archive-report.mjs --run --spec \"cypress/e2e/saucedemo/**/*.cy.js\"",
    "report:summary": "node shell/generate-summary.mjs",
    "report:archive": "node shell/archive-report.mjs",
    "docker:test": "docker compose up cypress",
    "docker:dev": "docker compose --profile dev up cypress-dev",
    "docker:repeat": "docker compose --profile repeat run --rm cypress-repeat"
  },
  "dependencies": {
    "cypress": "15.14.1",
    "cypress-clipboard": "^1.0.3",
    "cypress-iframe": "^1.0.1",
    "cypress-real-events": "^1.15.0",
    "cypress-repeat": "^2.3.6",
    "cypress-xpath": "^2.0.1",
    "dayjs": "^1.11.12",
    "mocha": "^10.6.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@cypress/grep": "^4.1.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "eslint": "^9.7.0"
  }
}
