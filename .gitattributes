# Force LF line endings for shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Force LF for other scripts that run in Linux containers
shell/*.js text eol=lf
shell/*.mjs text eol=lf

# Force LF for CI workflow files (GitHub Actions 러너는 Linux)
*.yml text eol=lf
*.yaml text eol=lf

# Default behavior for other files
* text=auto
